{
  "name": "paperreader",
  "productName": "PaperReader",
  "version": "0.3.0",
  "description": "macOS desktop companion for daily papers, local AI reading, Obsidian notes, and OneDrive-linked Zotero attachments.",
  "author": "scpsyl",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "test": "node --test ../test/*.test.js",
    "sync-site": "node sync-site.js",
    "audit:release": "node sync-site.js && node release-audit.js",
    "prestart": "node sync-site.js",
    "start": "electron .",
    "predist": "npm run audit:release",
    "dist": "electron-builder",
    "predist:mac": "npm run audit:release",
    "dist:mac": "electron-builder --mac --arm64 --x64"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.scpsyl.paperreader",
    "productName": "PaperReader",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!release-audit.js",
      "!**/*.md",
      "!**/.DS_Store",
      "!**/*.log",
      "!**/*.dmp",
      "!**/.env",
      "!**/.env.*",
      "!**/*.pem",
      "!**/*.p12",
      "!**/*.p8",
      "!**/*.key",
      "!**/*.mobileprovision",
      "!**/.npmrc",
      "!**/.pypirc",
      "!**/config.json",
      "!**/*.secure.json",
      "!site/js/secrets.enc.js",
      "!site/js/crypto.js",
      "!site/js/webdav.js",
      "!vendor/spark-md5.min.js",
      "!vendor/jszip.min.js"
    ],
    "extraResources": [
      {
        "from": "../skills/paper-reading",
        "to": "skills/paper-reading",
        "filter": [
          "**/*",
          "!**/.DS_Store",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.env",
          "!**/.env.*",
          "!**/.npmrc",
          "!**/.pypirc",
          "!**/config.json",
          "!**/*.secure.json",
          "!**/*.pem",
          "!**/*.p12",
          "!**/*.p8",
          "!**/*.key",
          "!**/*.mobileprovision"
        ]
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "README_ZH.md",
        "to": "README_ZH.md"
      }
    ],
    "icon": "build/icon.png",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "minimumSystemVersion": "12.0.0",
      "identity": null,
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "PaperReader-${version}-${arch}.${ext}"
    },
    "dmg": {
      "writeUpdateInfo": false
    }
  }
}
